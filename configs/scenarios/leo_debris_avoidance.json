{
  "algorithm": "ppo",
  "environment": {
    "scenario_file": "leo_debris_avoidance.json",
    "max_debris_tracked": 20,
    "collision_distance_km": 0.005,
    "near_miss_distance_km": 0.050,
    "episode_horizon": 1000,
    "render_mode": null
  }, 
  "stochasticity": {
    "enabled": true,
    "observation_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.001,
      "bias": 0.0,
      "scaling_factors": {
        "position": 0.5,
        "velocity": 0.3,
        "fuel": 0.01,
        "debris_relative": 0.8
      }
    },
    "dynamics_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.005,
      "scaling_factors": {
        "position": 0.4,
        "velocity": 0.05
      }
    },
    "control_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.02,
      "multiplicative": true
    },
    "initial_state_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.05,
      "scaling_factors": {
        "position": 0.5,
        "velocity": 0.005
      }
    },
    "environmental": {
      "atmospheric_density": {
        "enabled": true,
        "uncertainty_fraction": 0.10
      },
      "solar_flux": {
        "enabled": true,
        "uncertainty_fraction": 0.05
      }
    }
  },
  "training": {
    "total_timesteps": 10000000,
    "checkpoint_freq": 100000,
    "eval_freq": 25000,
    "save_best_only": true,
    "curriculum_learning": {
      "enabled": true,
      "stages": [
        {
          "timesteps": 2000000,
          "debris_multiplier": 0.3,
          "noise_multiplier": 0.5,
          "description": "Stage 1: Sparse debris, low noise"
        },
        {
          "timesteps": 3000000,
          "debris_multiplier": 0.5,
          "noise_multiplier": 0.7,
          "description": "Stage 2: Moderate debris, medium noise"
        },
        {
          "timesteps": 3000000,
          "debris_multiplier": 0.75,
          "noise_multiplier": 0.85,
          "description": "Stage 3: Dense debris, high noise"
        },
        {
          "timesteps": 2000000,
          "debris_multiplier": 1.0,
          "noise_multiplier": 1.0,
          "description": "Stage 4: Full complexity"
        }
      ]
    }
  },
  "output": {
    "log_dir": "./logs",
    "save_dir": "./trained_model",
    "experiment_name": "realistic_orbital_rl_v1"
  },
  "reward_function": "ppo_optimized",
  "ppo": {
    "learning_rate": 3.0e-4,
    "n_steps": 4096,
    "batch_size": 512,
    "n_epochs": 10,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "gae_lambda": 0.95,
    "gamma": 0.999,
    "vf_coef": 0.5,
    "ent_coef": 0.01,
    "max_grad_norm": 0.5,
    "target_kl": 0.015,
    "normalize_advantage": true
  },
  "satellites": [
    {
      "name": "MainSatellite",
      "orbit": {
        "altitude_km": 400,
        "inclination_deg": 51.6,
        "eccentricity": 0.001,
        "raan_deg": 0,
        "arg_periapsis_deg": 0,
        "mean_anomaly_deg": 0,
        "epoch_mjd": 59945.0
      },
      "mass_kg": 1100,
      "drag_area_m2": 10,
      "drag_coefficient": 2.2,
      "radiation_area_m2": 10,
      "radiation_coefficient": 1.8,
      "is_controllable": true,
      "max_thrust_n": 2.5,
      "fuel_capacity_kg": 150,
      "collision_radius_km": 0.010,
      "near_miss_radius_km": 0.050,
      "attitude_dependent_drag": false,
      "maneuver_efficiency": 0.85,
      "delta_v_budget_ms": 200.0
    }
  ],
  "debris_fields": [
    {
      "name": "imminent_threat_cloud",
      "num_objects": 40,
