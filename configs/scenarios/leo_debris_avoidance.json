    },
    {
      "name": "DirectThreat_2",
      "orbit": {
        "altitude_km": 400.0,
        "inclination_deg": 51.6,
        "eccentricity": 0.001,
        "raan_deg": 0,
        "arg_periapsis_deg": 0,
        "mean_anomaly_deg": 350
      },
      "mass_kg": 250,
      "drag_area_m2": 6,
      "is_controllable": false,
      "max_thrust_n": 0,
