      "inclination_range_deg": [51.55, 51.65],
      "eccentricity_range": [0.0, 0.003],
      "raan_range_deg": [0, 20],
      "arg_periapsis_range_deg": [0, 360],
      "mean_anomaly_range_deg": [0, 360],
      "mass_range_kg": [2, 80],
      "collision_radius_range_km": [0.0005, 0.002],
      "distribution_type": "swarm",
      "swarm_center_altitude_km": 400,
      "swarm_radius_km": 2
    }
  ],
  "static_debris": [
    {
      "name": "DirectThreat_1",
      "orbit": {
