{
  "scenario_name": "Advanced_Dense_LEO",
  "description": "High-density debris environment for advanced collision avoidance research.",
  "scenario_file": "configs/scenarios/Advanced_Dense_LEO.json",

  "satellites": [
    {
      "name": "ResearchSat",
      "orbit": {
        "altitude_km": 600,
        "inclination_deg": 98,
        "eccentricity": 0.001,
        "raan_deg": 0,
        "arg_periapsis_deg": 0,
        "mean_anomaly_deg": 0,
        "epoch_mjd": 59945.0
      },
      "mass_kg": 500,
      "drag_area_m2": 4.0,
      "drag_coefficient": 2.2,
      "radiation_area_m2": 4.0,
      "radiation_coefficient": 1.8,
      "is_controllable": true,
      "max_thrust_n": 1.5,
      "fuel_capacity_kg": 80,
      "collision_radius_m": 10.0,
      "attitude_dependent_drag": false,
      "maneuver_efficiency": 0.9,
      "delta_v_budget_ms": 100.0
    }
  ],

  "debris_fields": [
    {
      "name": "dense_shell",
      "num_objects": 2000,
      "altitude_range_km": [580, 620],
      "inclination_range_deg": [95, 105],
      "eccentricity_range": [0.0, 0.02],
      "distribution_type": "shell",
      "covariance_matrix": {
        "position_uncertainty_km": 0.05,
        "velocity_uncertainty_km_s": 0.001
      },
      "dynamics": {
        "enable_dynamics": true,
        "random_perturbations": true,
        "perturbation_magnitude_ms": 0.01,
        "update_frequency_seconds": 300
      }
    },
    {
      "name": "swarm_field",
      "num_objects": 10,
      "altitude_range_km": [590, 610],
      "inclination_range_deg": [95, 105],
      "eccentricity_range": [0.0, 0.01],
      "distribution_type": "swarm",
      "swarm_center_altitude_km": 600,
      "swarm_radius_km": 10.0,
      "relative_velocity_range_ms": [0.01, 0.1],
      "covariance_matrix": {
        "position_uncertainty_km": 0.1,
        "velocity_uncertainty_km_s": 0.002
      },
      "dynamics": {
        "enable_dynamics": true,
        "random_perturbations": true,
        "perturbation_magnitude_ms": 0.02,
        "update_frequency_seconds": 180
      }
    }
  ],

  "physics": {
    "propagator_type": "orekit_numerical",
    "integrator": {
      "type": "dormand_prince_853",
      "atol": 1e-10,
      "rtol": 1e-10,
      "adaptive_step": true,
      "min_step_seconds": 0.1,
      "max_step_seconds": 30
    },
    "gravity_model": {
      "degree": 8,
      "order": 8,
      "model": "egm96"
    },
    "atmosphere_model": {
      "type": "nrlmsise00",
      "solar_activity": {
        "f107": 150.0,
        "f107_avg": 145.0,
        "kp": 3.0
      },
      "daily_variation": true,
      "density_uncertainty": 0.15
    },
    "solar_radiation_model": {
      "type": "srp_with_eclipse",
      "solar_flux_wm2": 1361.0,
      "earth_shadow": true
    },
    "third_body_perturbations": {
      "include_sun": true,
      "include_moon": true
    },
    "time_step_seconds": 10,
    "simulation_duration_seconds": 7200,
    "include_drag": true,
    "include_solar_radiation": true,
    "include_j2_perturbation": true,
    "include_higher_order_gravity": true
  },

  "collision_detection": {
    "method": "probabilistic_enhanced",
    "hard_threshold_km": 0.001,
    "collision_threshold_km": 0.01,
    "probability_threshold": 1e-6,
    "covariance_propagation": true,
    "conjunction_screening_km": 10.0,
    "time_to_collision_threshold_hours": 6.0
  },

  "reward": {
    "reward_type": "multi_objective_balanced",
    "collision_penalty": -1000.0,
    "fuel_cost_weight": 0.2,
    "safety_distance_km": 0.05,
    "mission_success_reward": 200.0,
    "per_step_penalty": -0.05,
    "per_step_bonus": 0.01,
    "weights": {
      "safety": 0.7,
      "fuel_efficiency": 0.15,
      "mission_completion": 0.15
    }
  },

  "observations": {
    "include_relative_positions": true,
    "include_relative_velocities": true,
    "include_fuel_levels": true,
    "include_time_to_collision": true,
    "include_collision_probability": true,
    "max_tracked_objects": 20,
    "observation_radius_km": 150.0,
    "time_horizon_hours": 2.0,
    "observation_frequency_hz": 1.0
  },

  "randomization": {
    "enable_episode_randomization": true,
    "randomize_initial_conditions": true,
    "randomize_debris_positions": true,
    "randomize_debris_velocities": true,
    "randomize_satellite_state": true,
    "randomization_ranges": {
      "altitude_variation_km": 10.0,
      "inclination_variation_deg": 1.0,
      "raan_variation_deg": 30.0,
      "mean_anomaly_variation_deg": 360.0
    },
    "seed_strategy": "fixed_for_debug"
  },

  "training_optimization": {
    "enable_parallel_environments": true,
    "num_parallel_envs": 8,
    "memory_optimization": true,
    "gpu_acceleration": {
      "enable_gpu_physics": false,
      "preferred_device": "auto"
    }
  },

  "advanced_features": {
    "enable_conjunction_analysis": true,
    "enable_uncertainty_propagation": true
  },

  "random_seed": 42
}
