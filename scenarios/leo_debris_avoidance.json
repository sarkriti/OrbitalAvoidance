{
  "algorithm": "ppo",
  "environment": {
    "scenario_file": "leo_debris_avoidance.json",
    "max_debris_tracked": 20,
    "collision_distance_km": 0.005,
    "near_miss_distance_km": 0.050,
    "episode_horizon": 1500,
    "render_mode": null
  },
  "stochasticity": {
    "enabled": true,
    "observation_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.001,
      "bias": 0.0,
      "scaling_factors": {
        "position": 0.5,
        "velocity": 0.3,
        "fuel": 0.01,
        "debris_relative": 0.8
      }
    },
    "dynamics_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.005,
      "scaling_factors": {
        "position": 0.4,
        "velocity": 0.05
      }
    },
    "control_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.02,
      "multiplicative": true
    },
    "initial_state_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.05,
      "scaling_factors": {
        "position": 0.5,
        "velocity": 0.005
      }
    },
    "environmental": {
      "atmospheric_density": {
        "enabled": true,
        "uncertainty_fraction": 0.10
      },
      "solar_flux": {
        "enabled": true,
        "uncertainty_fraction": 0.05
      }
    }
  },
  "training": {
    "total_timesteps": 10000000,
    "checkpoint_freq": 100000,
    "eval_freq": 25000,
    "save_best_only": true,
    "curriculum_learning": {
      "enabled": true,
      "stages": [
        {
          "timesteps": 2000000,
          "debris_multiplier": 0.3,
          "noise_multiplier": 0.5,
          "description": "Stage 1: Sparse debris, low noise"
        },
        {
          "timesteps": 3000000,
          "debris_multiplier": 0.5,
          "noise_multiplier": 0.7,
          "description": "Stage 2: Moderate debris, medium noise"
        },
        {
          "timesteps": 3000000,
          "debris_multiplier": 0.75,
          "noise_multiplier": 0.85,
          "description": "Stage 3: Dense debris, high noise"
        },
        {
          "timesteps": 2000000,
          "debris_multiplier": 1.0,
          "noise_multiplier": 1.0,
          "description": "Stage 4: Full complexity"
        }
      ]
    }
  },
  "output": {
    "log_dir": "./logs",
    "save_dir": "./trained_model",
    "experiment_name": "realistic_orbital_rl_v1"
  },
  "reward_function": "ppo_optimized",
  "ppo": {
    "learning_rate": 3.0e-4,
    "n_steps": 4096,
    "batch_size": 512,
    "n_epochs": 10,
    "clip_range": 0.2,
    "clip_range_vf": null,
    "gae_lambda": 0.95,
    "gamma": 0.999,
    "vf_coef": 0.5,
    "ent_coef": 0.01,
    "max_grad_norm": 0.5,
    "target_kl": 0.015,
    "normalize_advantage": true
  },
  "satellites": [
    {
      "name": "MainSatellite",
      "orbit": {
        "altitude_km": 400,
        "inclination_deg": 51.6,
        "eccentricity": 0.001,
        "raan_deg": 0,
        "arg_periapsis_deg": 0,
        "mean_anomaly_deg": 0,
        "epoch_mjd": 59945.0
      },
      "mass_kg": 1100,
      "drag_area_m2": 10,
      "drag_coefficient": 2.2,
      "radiation_area_m2": 10,
      "radiation_coefficient": 1.8,
      "is_controllable": true,
      "max_thrust_n": 2.5,
      "fuel_capacity_kg": 150,
      "collision_radius_km": 0.001,
      "near_miss_radius_km": 0.050,
      "attitude_dependent_drag": false,
      "maneuver_efficiency": 0.85,
      "delta_v_budget_ms": 200.0
    }
  ],
  "debris_fields": [
    {
      "name": "primary_leo_cloud",
      "num_objects": 30,
      "altitude_range_km": [395, 405],
      "inclination_range_deg": [49, 54],
      "eccentricity_range": [0.0, 0.025],
      "raan_range_deg": [0, 360],
      "arg_periapsis_range_deg": [0, 360],
      "mean_anomaly_range_deg": [0, 360],
      "mass_range_kg": [5, 150],
      "collision_radius_range_km": [0.0005, 0.003],
      "near_miss_multiplier": 10.0,
      "distribution_type": "realistic_density"
    },
    {
      "name": "crossing_debris_belt",
      "num_objects": 20,
      "altitude_range_km": [396, 404],
      "inclination_range_deg": [46, 50],
      "eccentricity_range": [0.005, 0.03],
      "raan_range_deg": [60, 300],
      "arg_periapsis_range_deg": [0, 360],
      "mean_anomaly_range_deg": [0, 360],
      "mass_range_kg": [8, 100],
      "collision_radius_range_km": [0.0006, 0.0025],
      "distribution_type": "clustered"
    },
    {
      "name": "dense_swarm",
      "num_objects": 15,
      "altitude_range_km": [398, 402],
      "inclination_range_deg": [50.5, 52.5],
      "eccentricity_range": [0.0, 0.012],
      "raan_range_deg": [0, 360],
      "arg_periapsis_range_deg": [0, 360],
      "mean_anomaly_range_deg": [0, 360],
      "mass_range_kg": [2, 40],
      "collision_radius_range_km": [0.0003, 0.0012],
      "distribution_type": "swarm",
      "swarm_center_altitude_km": 400,
      "swarm_radius_km": 15
    }
  ],
  "static_debris": [
    {
      "name": "StaticDebris_A",
      "orbit": {
        "altitude_km": 401.5,
        "inclination_deg": 51.6,
        "eccentricity": 0.001,
        "raan_deg": 5,
        "arg_periapsis_deg": 30,
        "mean_anomaly_deg": 200
      },
      "mass_kg": 200,
      "drag_area_m2": 5,
      "is_controllable": false,
      "max_thrust_n": 0,
      "fuel_capacity_kg": 0,
      "collision_radius_km": 0.002
    },
    {
      "name": "StaticDebris_B",
      "orbit": {
        "altitude_km": 398.5,
        "inclination_deg": 51.6,
        "eccentricity": 0.0015,
        "raan_deg": 180,
        "arg_periapsis_deg": 120,
        "mean_anomaly_deg": 90
      },
      "mass_kg": 150,
      "drag_area_m2": 3,
      "is_controllable": false,
      "max_thrust_n": 0,
      "fuel_capacity_kg": 0,
      "collision_radius_km": 0.0015
    }
  ],
  "physics": {
    "propagator_type": "orekit_numerical",
    "integrator": {
      "type": "dormand_prince_853",
      "atol": 1e-9,
      "rtol": 1e-9,
      "adaptive_step": true,
      "min_step_seconds": 0.5,
      "max_step_seconds": 30
    },
    "gravity_model": {
      "degree": 8,
      "order": 8,
      "model": "egm96"
    },
    "atmosphere_model": {
      "type": "nrlmsise00",
      "solar_activity": {
        "f107": 150.0,
        "f107_avg": 145.0,
        "kp": 3.0
      }
    },
    "solar_radiation_model": {
      "type": "srp_with_eclipse",
      "solar_flux_wm2": 1361.0,
      "earth_shadow": true
    },
    "third_body_perturbations": {
      "include_sun": true,
      "include_moon": true
    },
    "time_step_seconds": 10,
    "simulation_duration_seconds": 15000,
    "include_drag": true,
    "include_solar_radiation": true,
    "include_j2_perturbation": true,
    "include_higher_order_gravity": true
  },
  "collision_detection": {
    "method": "spherical_with_prediction",
    "collision_threshold_km": 0.002,
    "conjunction_screening_km": 0.075,
    "prediction_horizon_seconds": 300
  },
  "observations": {
    "include_relative_positions": true,
    "include_relative_velocities": true,
    "include_fuel_levels": true,
    "include_time_to_collision": true,
    "include_collision_probability": true,
    "max_tracked_objects": 20,
    "observation_radius_km": 0.150,
    "time_horizon_hours": 2.0,
    "observation_frequency_hz": 2.0,
    "prioritization_scheme": "threat_based"
  },
  "rewards": {
    "collision_penalty": -50.0,
    "mission_success_reward": 10.0,
    "fuel_cost_weight": 0.01,
    "survival_bonus": 0.005,
    "proximity_penalties": {
      "critical_distance_km": 0.008,
      "warning_distance_km": 0.025,
      "safe_distance_km": 0.075,
      "critical_penalty": -10.0,
      "warning_penalty": -1.0,
      "safe_bonus": 0.01
    }
  },
  "control": {
    "max_delta_v_km_s": 0.001,
    "fuel_consumption_rate_kg_per_km_s": 100.0,
    "thrust_vectoring": true,
    "reaction_wheel_torque_nm": 0.1
  },
  "randomization": {
    "enable_episode_randomization": true,
    "randomize_initial_conditions": true,
    "randomize_debris_positions": true,
    "randomize_debris_velocities": false,
    "randomize_satellite_state": true,
    "randomize_environmental_conditions": true,
    "randomization_ranges": {
      "altitude_variation_km": 3.0,
      "inclination_variation_deg": 1.5,
      "raan_variation_deg": 30.0,
      "mean_anomaly_variation_deg": 180.0,
      "debris_density_multiplier": [0.8, 1.2]
    },
    "seed_strategy": "random_each_episode"
  },
  "training_optimization": {
    "enable_parallel_environments": true,
    "num_parallel_envs": 8,
    "gpu_acceleration": {
      "enable_gpu_physics": false,
      "enable_gpu_observations": true
    },
    "memory_optimization": {
      "compress_observations": true,
      "observation_buffer_size": 1000
    }
  },
  "random_seed": 42
}