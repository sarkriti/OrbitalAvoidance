{
  "algorithm": "ppo",
  "environment": {
    "scenario_file": "leo_debris_avoidance.json",
    "max_debris_tracked": 20,
    "collision_distance_km": 0.005,
    "near_miss_distance_km": 0.050,
    "episode_horizon": 1500,
    "render_mode": null
  },
  "stochasticity": {
    "enabled": true,
    "observation_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.002,
      "bias": 0.0,
      "scaling_factors": {
        "position": 0.7,
        "velocity": 0.4,
        "fuel": 0.02,
        "debris_relative": 1.2
      }
    },
    "dynamics_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.008,
      "scaling_factors": {
        "position": 0.6,
        "velocity": 0.08
      }
    },
    "control_noise": {
      "enabled": true,
      "type": "gaussian",
      "std_dev": 0.03,
      "multiplicative": true
    },
    "initial_state_noise": {
      "enabled": true,
      "type": "gaussian", 
      "std_dev": 0.08,
      "scaling_factors": {
        "position": 0.7,
        "velocity": 0.008
      }
    },
    "environmental": {
      "atmospheric_density": {
        "enabled": true,
        "uncertainty_fraction": 0.15
      },
      "solar_flux": {
        "enabled": true,
        "uncertainty_fraction": 0.08
      }
    }
  },
  "training": {
    "total_timesteps": 10000000,
    "checkpoint_freq": 100000,
    "eval_freq": 25000,
    "save_best_only": true,
    "curriculum_learning": {
      "enabled": true,
      "stages": [
        {
          "timesteps": 2000000,
          "debris_multiplier": 0.6,
          "noise_multiplier": 0.7
        },
        {
          "timesteps": 4000000,
          "debris_multiplier": 0.8,
          "noise_multiplier": 0.85
        },
        {
          "timesteps": 4000000,
          "debris_multiplier": 1.0,
          "noise_multiplier": 1.0
        }
      ]
    }
  },
  "output": {
    "log_dir": "./logs",
    "save_dir": "./trained_model",
    "experiment_name": "enhanced_orbital_rl"
  },
  "reward_function": "balanced",
  "ppo": {
    "learning_rate": 2.5e-4,
    "n_steps": 4096,
    "batch_size": 512,
    "n_epochs": 8,
    "clip_range": 0.15,
    "gae_lambda": 0.97,
    "gamma": 0.9995,
    "value_function_coeff": 0.5,
    "entropy_coeff": 0.01
  },
  "satellites": [
    {
      "name": "MainSatellite",
      "orbit": {
        "altitude_km": 400,
        "inclination_deg": 51.6,
        "eccentricity": 0.001,
