        "arg_periapsis_deg": 270,
        "mean_anomaly_deg": 45
      },
      "mass_kg": 300,
      "drag_area_m2": 8,
      "is_controllable": false,
      "max_thrust_n": 0,
      "fuel_capacity_kg": 0,
      "collision_radius_km": 0.0025
    }
  ],
  "physics": {
    "propagator_type": "orekit_numerical",
    "integrator": {
      "type": "dormand_prince_853",
      "atol": 1e-9,
      "rtol": 1e-9,
      "adaptive_step": true,
      "min_step_seconds": 0.5,
      "max_step_seconds": 30
    },
    "gravity_model": {
      "degree": 10,
      "order": 10,
      "model": "egm96"
    },
    "atmosphere_model": {
      "type": "nrlmsise00",
      "solar_activity": {
        "f107": 150.0,
        "f107_avg": 145.0,
        "kp": 3.0
      }
    },
    "solar_radiation_model": {
      "type": "srp_with_eclipse",
      "solar_flux_wm2": 1361.0,
      "earth_shadow": true
    },
    "third_body_perturbations": {
      "include_sun": true,
      "include_moon": true
    },
    "time_step_seconds": 5,
    "simulation_duration_seconds": 15000,
    "include_drag": true,
    "include_solar_radiation": true,
    "include_j2_perturbation": true,
    "include_higher_order_gravity": true
  },
  "collision_detection": {
    "method": "spherical_with_prediction",
    "collision_threshold_km": 0.00001,
    "conjunction_screening_km": 0.075,
    "prediction_horizon_seconds": 300
  },
  "observations": {
    "include_relative_positions": true,
    "include_relative_velocities": true,
    "include_fuel_levels": true,
    "include_time_to_collision": true,
    "include_collision_probability": true,
    "max_tracked_objects": 20,
    "observation_radius_km": 0.150,
    "time_horizon_hours": 2.0,
    "observation_frequency_hz": 2.0,
    "prioritization_scheme": "threat_based"
  },
  "rewards": {
    "reward_type": "multi_objective_adaptive",
    "collision_penalty": -1000.0,
    "fuel_cost_weight": 0.08,
    "safety_distance_km": 0.050,
    "close_approach_penalty_weight": 8.0,
    "mission_success_reward": 15.0,
    "fuel_efficiency_bonus": 5.0,
    "proximity_penalties": {
      "critical_distance_km": 0.008,
      "warning_distance_km": 0.025,
      "safe_distance_km": 0.075,
      "critical_penalty": -100.0,
      "warning_penalty": -10.0,
      "safe_bonus": 1.0
    },
    "temporal_penalties": {
      "persistent_threat_multiplier": 1.5,
      "evasion_success_bonus": 20.0
    }
  },
  "control": {
    "max_delta_v_km_s": 0.0015,
    "fuel_consumption_rate_kg_per_km_s": 95.0,
    "thrust_vectoring": true,
    "reaction_wheel_torque_nm": 0.1
  },
  "randomization": {
    "enable_episode_randomization": true,
    "randomize_initial_conditions": true,
    "randomize_debris_positions": true,
    "randomize_debris_velocities": true,
    "randomize_satellite_state": true,
    "randomize_environmental_conditions": true,
    "randomization_ranges": {
      "altitude_variation_km": 5.0,
      "inclination_variation_deg": 2.0,
      "raan_variation_deg": 45.0,
      "mean_anomaly_variation_deg": 360.0,
      "debris_density_multiplier": [0.7, 1.3]
    },
    "seed_strategy": "random_each_episode"
  },
  "training_optimization": {
    "enable_parallel_environments": true,
    "num_parallel_envs": 8,
    "gpu_acceleration": {
      "enable_gpu_physics": false,
      "enable_gpu_observations": true
    },
    "memory_optimization": {
      "compress_observations": true,
      "observation_buffer_size": 1000
    }
  },
  "random_seed": 42
}