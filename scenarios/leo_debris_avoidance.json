      "eccentricity_range": [0.02, 0.05],
      "raan_range_deg": [0, 360],
      "arg_periapsis_range_deg": [0, 360],
      "mean_anomaly_range_deg": [0, 360],
      "mass_range_kg": [0.5, 25],
      "collision_radius_range_km": [0.0001, 0.0008],
